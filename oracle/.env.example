# The chain your Escrow contract is deployed on (the "source" chain for this instance)
SOURCE_RPC_URL=wss://your-alchemy-or-infura-websocket-url
SOURCE_CHAIN_ID=11155111

# Deployed Escrow contract address on the source chain
ESCROW_ADDRESS=0xYourDeployedEscrowAddress

# Private key of the wallet the Escrow contract trusts as an oracle
# (must be added via setOracle() at deploy time or afterward by the owner)
# NEVER use a real/funded wallet's key here. Testnet only.
ORACLE_PRIVATE_KEY=0xyourtestnetonlyprivatekey

# How long to "check" the destination chain before responding (ms)
CONFIRM_DELAY_MS=15000

# Optional: any lock() sent to this recipient address will be deliberately
# reported as failed, so you can demo the refund path live on demand.
FAIL_TEST_RECIPIENT=0x000000000000000000000000000000000000dEaD

# Optional: block number to start backfill scanning from (defaults to ~5000 blocks back)
# START_BLOCK=
